#!/bin/bash
set -euo pipefail
export HOP_CONFIG_FOLDER="${HOP_CONFIG_FOLDER:-/config/hop-config}"
export HOP_AUDIT_FOLDER="${HOP_AUDIT_FOLDER:-$HOP_CONFIG_FOLDER/audit}"
mkdir -p "$HOP_CONFIG_FOLDER" "$HOP_AUDIT_FOLDER"
cd /opt/hop
PROJECT=/config/workspace/hop-project
SECRETS_FILE="$HOP_CONFIG_FOLDER/docker-secrets.json"
./hop-conf.sh -cfg "$SECRETS_FILE" -cfv "LAB_DB_PASSWORD=${LAB_DB_PASSWORD:-},LAB_MYSQL_PASSWORD=${LAB_MYSQL_PASSWORD:-}"
if ! ./hop-conf.sh -pl | grep -q 'capstone-local'; then
  ./hop-conf.sh --project-create --project=capstone-local --project-home="$PROJECT"
fi
if ./hop-conf.sh -el | grep -q '^  capstone-local$'; then
  ./hop-conf.sh --environment-delete --environment=capstone-local
fi
if ./hop-conf.sh -el | grep -q '^  docker-local$'; then
  ./hop-conf.sh --environment-delete --environment=docker-local
fi
./hop-conf.sh --environment-create --environment=docker-local \
  --environment-project=capstone-local --environment-purpose=Development \
  --environment-config-files="$PROJECT/environments/docker-local.json,$SECRETS_FILE"
./hop-conf.sh -dp=capstone-local -de=docker-local
ENV_AUDIT_DIR="$HOP_AUDIT_FOLDER/projects/environment"
mkdir -p "$ENV_AUDIT_DIR"
rm -f "$ENV_AUDIT_DIR"/*.event
printf '{"group":"projects","type":"environment","name":"docker-local","operation":"open","date":%s000}\n' "$(date +%s)" \
  > "$ENV_AUDIT_DIR/$(date +%Y%m%d-%H%M%S).000-open.event"
./hop-conf.sh --project=capstone-local --export-metadata=/config/workspace/metadata-export.json || true
echo 'Hop project capstone-local and environment docker-local registered.'
