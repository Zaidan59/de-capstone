#!/bin/bash
set -euo pipefail
export HOP_CONFIG_FOLDER="${HOP_CONFIG_FOLDER:-/config/hop-config}"
mkdir -p "$HOP_CONFIG_FOLDER"
cd /opt/hop
PROJECT=/config/workspace/hop-project
if ! ./hop-conf.sh -pl | grep -q 'capstone-local'; then
  ./hop-conf.sh --project-create --project=capstone-local --project-home="$PROJECT"
fi
if ! ./hop-conf.sh -el | grep -q 'docker-local'; then
  ./hop-conf.sh --environment-create --environment=docker-local \
    --environment-project=capstone-local --environment-purpose=Development \
    --environment-config-files="$PROJECT/environments/docker-local.json"
fi
./hop-conf.sh --project=capstone-local --export-metadata=/config/workspace/metadata-export.json || true
echo 'Hop project capstone-local and environment docker-local registered.'
