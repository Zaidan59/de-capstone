<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_main_etl</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>End-to-end Capstone Group A03 orchestrator: resilient ingest (live API + fallback snapshot) -&gt; stg -&gt; DQ &amp; reconcile -&gt; curated star schema -&gt; ops manifest (A03-24, A03-14)</description>
  <extended_description/>
  <workflow_version>1.0</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/11/26 10:28:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/26 10:28:00.000</modified_date>
  <parameters>
    <parameter>
      <name>SIMULATE_BMKG_FAIL</name>
      <default_value>N</default_value>
      <description>Set Y for controlled API outage &amp; fallback recovery test (A03-27)</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name><description/><type>SPECIAL</type><attributes/>
      <repeat>N</repeat><schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel><xloc>48</xloc><yloc>112</yloc><attributes_hac/>
    </action>
    <action>
      <name>Init Snapshot &amp; Run Start</name><description/><type>SQL</type><attributes/>
      <connection>lab-postgres</connection><sendOneStatement>F</sendOneStatement>
      <sql>CREATE TABLE IF NOT EXISTS ops.last_good_bmkg_forecast (LIKE raw.bmkg_forecast);
CREATE TABLE IF NOT EXISTS ops.last_good_openmeteo_live (LIKE raw.openmeteo_live);

DELETE FROM ops.last_good_bmkg_forecast WHERE (SELECT COUNT(*) FROM raw.bmkg_forecast) &gt; 0;
INSERT INTO ops.last_good_bmkg_forecast
SELECT * FROM raw.bmkg_forecast WHERE (SELECT COUNT(*) FROM raw.bmkg_forecast) &gt; 0;

DELETE FROM ops.last_good_openmeteo_live WHERE (SELECT COUNT(*) FROM raw.openmeteo_live) &gt; 0;
INSERT INTO ops.last_good_openmeteo_live
SELECT * FROM raw.openmeteo_live WHERE (SELECT COUNT(*) FROM raw.openmeteo_live) &gt; 0;

INSERT INTO ops.run_manifest (
  workflow_name, step_name, source_or_target, status, fallback_used, started_at, completed_at, duration_ms
) VALUES (
  'wf_main_etl', '00_init_snapshot', 'ops.last_good_*', 'SUCCESS', FALSE, now(), now(), 0
);</sql>
      <sqlfilename/><sqlfromfile>F</sqlfromfile><useVariableSubstitution>F</useVariableSubstitution>
      <parallel>N</parallel><xloc>192</xloc><yloc>112</yloc><attributes_hac/>
    </action>
    <action>
      <name>Check BMKG API Gate</name><description/><type>SQL</type><attributes/>
      <connection>lab-postgres</connection><sendOneStatement>F</sendOneStatement>
      <sql>SELECT 1 / (CASE WHEN '${SIMULATE_BMKG_FAIL}' = 'Y' THEN 0 ELSE 1 END);</sql>
      <sqlfilename/><sqlfromfile>F</sqlfromfile><useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel><xloc>272</xloc><yloc>112</yloc><attributes_hac/>
    </action>
    <action>
      <name>Ingest BMKG Live API</name><description/><type>PIPELINE</type><attributes/>
      <filename>${PROJECT_HOME}/pipelines/raw/pl_ingest_bmkg.hpl</filename>
      <params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <parallel>N</parallel><xloc>368</xloc><yloc>112</yloc><attributes_hac/>
    </action>
    <action>
      <name>Fallback Restore BMKG Snapshot</name><description/><type>SQL</type><attributes/>
      <connection>lab-postgres</connection><sendOneStatement>F</sendOneStatement>
      <sql>TRUNCATE raw.bmkg_forecast;
INSERT INTO raw.bmkg_forecast SELECT * FROM ops.last_good_bmkg_forecast;
INSERT INTO ops.run_manifest (
  workflow_name, step_name, source_or_target, rows_in, rows_accepted,
  status, fallback_used, error_message, started_at, completed_at, duration_ms
)
SELECT 'wf_main_etl', '01_ingest_bmkg_fallback', 'raw.bmkg_forecast',
       COUNT(*), COUNT(*), 'RECOVERED_FALLBACK', TRUE,
       'Live BMKG API failed after 3 retries; restored last verified snapshot',
       now(), now(), 0
FROM raw.bmkg_forecast;</sql>
      <sqlfilename/><sqlfromfile>F</sqlfromfile><useVariableSubstitution>F</useVariableSubstitution>
      <parallel>N</parallel><xloc>368</xloc><yloc>240</yloc><attributes_hac/>
    </action>
