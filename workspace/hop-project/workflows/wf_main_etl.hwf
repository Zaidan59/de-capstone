    <action>
      <sql>WITH init_ts AS (
  SELECT COALESCE(MAX(started_at), now()) AS ts
  FROM ops.run_manifest
  WHERE workflow_name = 'wf_main_etl' AND step_name = '00_init_snapshot'
),
fb AS (
  SELECT EXISTS (
    SELECT 1 FROM ops.run_manifest, init_ts
    WHERE workflow_name = 'wf_main_etl' AND fallback_used = TRUE AND started_at >= init_ts.ts
  ) AS used_fb
),
stats AS (
  SELECT (SELECT COUNT(*) FROM curated.fact_food_supply_daily) AS fact_cnt,
         (SELECT COUNT(*) FROM stg.food_prices_daily) AS stg_price_cnt,
         (SELECT COUNT(*) FROM stg.weather_daily) AS stg_weather_cnt,
         (SELECT COUNT(*) FROM stg.quarantine_records) AS q_cnt
),
ins_run AS (
  INSERT INTO ops.pipeline_runs (pipeline_name, started_at, completed_at, status, rows_processed, message)
  SELECT 'wf_main_etl', init_ts.ts, now(),
         CASE WHEN fb.used_fb THEN 'SUCCESS_WITH_FALLBACK' ELSE 'SUCCESS' END,
         stats.fact_cnt,
         'stg_prices=' || stats.stg_price_cnt || ', stg_weather=' || stats.stg_weather_cnt || ', quarantined=' || stats.q_cnt
  FROM init_ts, fb, stats
  RETURNING run_id, started_at, completed_at
)
INSERT INTO ops.run_manifest (
  run_id, workflow_name, step_name, source_or_target,
  rows_in, rows_accepted, rows_quarantined, status, fallback_used,
  started_at, completed_at, duration_ms
)
SELECT ins_run.run_id,
       'wf_main_etl',
       '99_end_to_end_complete',
       'curated.fact_food_supply_daily',
       stats.stg_price_cnt + stats.stg_weather_cnt,
       stats.fact_cnt,
       stats.q_cnt,
       CASE WHEN fb.used_fb THEN 'SUCCESS_WITH_FALLBACK' ELSE 'SUCCESS' END,
       fb.used_fb,
       ins_run.started_at,
       ins_run.completed_at,
       ROUND(EXTRACT(EPOCH FROM (ins_run.completed_at - ins_run.started_at)) * 1000)::bigint
FROM ins_run, fb, stats;</sql>
