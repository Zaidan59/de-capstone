    <hop><from>Ingest Batch &amp; Reference Sources</from><to>Ingest OpenMeteo Archive</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Ingest OpenMeteo Archive</from><to>Ingest FX &amp; HBKN</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Ingest FX &amp; HBKN</from><to>Ingest HBKN Calendar</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Ingest HBKN Calendar</from><to>Ingest InfoPangan &amp; DKI</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
