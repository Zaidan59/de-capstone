    <hop><from>Check BMKG API Gate</from><to>Fallback Restore BMKG Snapshot</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Ingest BMKG Live API</from><to>Ingest OpenMeteo Live API</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Ingest BMKG Live API</from><to>Fallback Restore BMKG Snapshot</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Fallback Restore BMKG Snapshot</from><to>Ingest OpenMeteo Live API</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Ingest OpenMeteo Live API</from><to>Ingest Batch &amp; Reference Sources</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
