  <hops>
    <hop><from>Start</from><to>Ensure raw tables</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Ensure raw tables</from><to>pl_ingest_bmkg.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_bmkg.hpl</from><to>pl_ingest_openmeteo_live.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_openmeteo_live.hpl</from><to>pl_ingest_openmeteo_archive.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_openmeteo_archive.hpl</from><to>pl_ingest_fx.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_fx.hpl</from><to>pl_ingest_hbkn.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_hbkn.hpl</from><to>pl_ingest_info_pangan_jkt.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_info_pangan_jkt.hpl</from><to>pl_ingest_pihps_mysql.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_pihps_mysql.hpl</from><to>pl_ingest_pihps_produsen.hpl</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>pl_ingest_pihps_produsen.hpl</from><to>Success</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
