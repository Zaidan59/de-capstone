<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_ingest_all_sources</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Ensure raw.* tables exist and ingest all currently available Capstone Group A03 sources (SRC-01..09, SRC-13)</description>
  <extended_description/>
  <workflow_version>1.0</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/11/18 14:10:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/18 14:10:00.000</modified_date>
  <parameters/>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat><schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>48</xloc><yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Ensure raw tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>lab-postgres</connection>
      <sendOneStatement>F</sendOneStatement>
      <sql>CREATE TABLE IF NOT EXISTS raw.bmkg_forecast (
  region_key text NOT NULL,
  region_name text NOT NULL,
  adm4_code text NOT NULL,
  kotkab text,
  kecamatan text,
  desa text,
  utc_datetime text,
  local_datetime text,
  t_celsius double precision,
  hu_pct double precision,
  tp_mm double precision,
  ws_kmh double precision,
  wd text,
  tcc_pct double precision,
  weather_code integer,
  weather_desc text,
  analysis_date text,
  http_status integer,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.openmeteo_live (
  region_key text NOT NULL,
  region_name text NOT NULL,
  weather_date text,
  temperature_2m_max_c double precision,
  precipitation_sum_mm double precision,
  rain_sum_mm double precision,
  http_status integer,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.openmeteo_archive (
  source_file text NOT NULL,
  weather_date text,
  temperature_2m_max_c double precision,
  precipitation_sum_mm double precision,
  rain_sum_mm double precision,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.fx_usd_idr (
  rate_date text NOT NULL,
  base_currency text NOT NULL,
  quote_currency text NOT NULL,
  usd_idr_rate double precision,
  source_api text,
  fetched_at text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.hbkn_calendar (
  holiday_date text NOT NULL,
  year integer,
  local_name text,
  name text,
  country_code text,
  fixed boolean,
  global_holiday boolean,
  hbkn_category text,
  is_hbkn_major boolean,
  source_api text,
  fetched_at text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.info_pangan_jkt (
  periode_data text,
  komoditas text,
  harga_rata_rata_raw text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.pihps_market_prices (
  market_tier text NOT NULL,
  commodity text NOT NULL,
  date_param text NOT NULL,
  dki_jakarta double precision,
  jawa_barat double precision,
  jawa_tengah double precision,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.pihps_produsen_prices (
  commodity text NOT NULL,
  date_param text NOT NULL,
  jawa_barat double precision,
  jawa_tengah double precision,
  ingested_at timestamptz NOT NULL DEFAULT now()
);</sql>
      <sqlfilename/>
      <sqlfromfile>F</sqlfromfile>
      <useVariableSubstitution>F</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>192</xloc><yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>pl_ingest_bmkg.hpl</name><description/><type>PIPELINE</type><attributes/>
      <filename>${PROJECT_HOME}/pipelines/pl_ingest_bmkg.hpl</filename>
      <params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <parallel>N</parallel><xloc>352</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>pl_ingest_openmeteo_live.hpl</name><description/><type>PIPELINE</type><attributes/>
      <filename>${PROJECT_HOME}/pipelines/pl_ingest_openmeteo_live.hpl</filename>
      <params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <parallel>N</parallel><xloc>528</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>pl_ingest_openmeteo_archive.hpl</name><description/><type>PIPELINE</type><attributes/>
      <filename>${PROJECT_HOME}/pipelines/pl_ingest_openmeteo_archive.hpl</filename>
      <params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
