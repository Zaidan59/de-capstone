<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_ingest_all_sources</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Ensure raw.* &amp; ops tables exist, ingest all 13 Capstone Group A03 sources (SRC-01..13), and log run summary to ops.pipeline_runs</description>
  <extended_description/>
  <workflow_version>1.0</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/11/18 14:10:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/25 13:35:00.000</modified_date>
  <parameters/>
  <actions>
    <action>
      <name>Start</name><description/><type>SPECIAL</type><attributes/>
      <repeat>N</repeat><schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel><xloc>48</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>Ensure raw tables</name><description/><type>SQL</type><attributes/>
      <connection>lab-postgres</connection><sendOneStatement>F</sendOneStatement>
      <sql>CREATE TABLE IF NOT EXISTS ops.pipeline_watermarks (
  source_name text PRIMARY KEY,
  last_watermark text,
  data_version text,
  last_run_id bigint,
  updated_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.bmkg_forecast (
  region_key text NOT NULL,
  region_name text NOT NULL,
  adm4_code text NOT NULL,
  kotkab text,
  kecamatan text,
  desa text,
  utc_datetime text,
  local_datetime text,
  t_celsius double precision,
  hu_pct double precision,
  tp_mm double precision,
  ws_kmh double precision,
  wd text,
  tcc_pct double precision,
  weather_code integer,
  weather_desc text,
  analysis_date text,
  http_status integer,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.openmeteo_live (
  region_key text NOT NULL,
  region_name text NOT NULL,
  weather_date text,
  temperature_2m_max_c double precision,
  precipitation_sum_mm double precision,
  rain_sum_mm double precision,
  http_status integer,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.openmeteo_archive (
  source_file text NOT NULL,
  weather_date text,
  temperature_2m_max_c double precision,
  precipitation_sum_mm double precision,
  rain_sum_mm double precision,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.fx_usd_idr (
  rate_date text NOT NULL,
  base_currency text NOT NULL,
  quote_currency text NOT NULL,
  usd_idr_rate double precision,
  source_api text,
  fetched_at text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.hbkn_calendar (
  holiday_date text NOT NULL,
  year integer,
  local_name text,
  name text,
  country_code text,
  fixed boolean,
  global_holiday boolean,
  hbkn_category text,
  is_hbkn_major boolean,
  source_api text,
  fetched_at text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.info_pangan_jkt (
  periode_data text,
  komoditas text,
  harga_rata_rata_raw text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.dki_harga_pokok_bulanan (
  periode_data text,
  wilayah text,
  komoditas text,
  harga_raw text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.pihps_market_prices (
  market_tier text NOT NULL,
  commodity text NOT NULL,
  date_param text NOT NULL,
  dki_jakarta double precision,
  jawa_barat double precision,
  jawa_tengah double precision,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.pihps_produsen_prices (
  commodity text NOT NULL,
  date_param text NOT NULL,
  jawa_barat double precision,
  jawa_tengah double precision,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.ref_bbm_esdm (
  bbm_id text NOT NULL,
  jenis_bbm text,
  kategori_bbm text,
  harga_per_liter double precision,
  dasar_regulasi text,
  valid_from text,
  valid_to text,
  is_current boolean,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.ref_bapanas_het (
  reg_id text NOT NULL,
  komoditas text,
  varian_mutu text,
  jenis_batas text,
  batas_bawah_rp double precision,
  batas_atas_rp double precision,
  dasar_regulasi text,
  valid_from text,
  valid_to text,
  is_current boolean,
  ingested_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS raw.ref_supply_corridor (
  source_id text,
  corridor_id text NOT NULL,
  commodity_code text,
  komoditas text,
  region_code text,
  kabupaten_sentra text,
  provinsi_sentra text,
  pasar_tujuan text,
  latitude_ref double precision,
  longitude_ref double precision,
  corridor_type text,
  verification_status text,
  active_for_join boolean,
  bobot_kontribusi_pasokan double precision,
  bobot_scope text,
  bobot_period text,
  evidence_row_ids text,
  source_url text,
  notes text,
  ingested_at timestamptz NOT NULL DEFAULT now()
);</sql>
