      <parallel>N</parallel><xloc>352</xloc><yloc>208</yloc><attributes_hac/>
    </action>
    <action>
      <name>pl_ingest_pihps_mysql.hpl</name><description/><type>PIPELINE</type><attributes/>
      <filename>${PROJECT_HOME}/pipelines/pl_ingest_pihps_mysql.hpl</filename>
