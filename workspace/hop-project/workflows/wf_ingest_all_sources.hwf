    <action>
      <name>Log ops.pipeline_runs &amp; watermarks</name><description/><type>SQL</type><attributes/>
      <connection>lab-postgres</connection><sendOneStatement>F</sendOneStatement>
      <sql>WITH counts AS (
  SELECT
    (SELECT COUNT(*) FROM raw.bmkg_forecast)
    + (SELECT COUNT(*) FROM raw.openmeteo_live)
    + (SELECT COUNT(*) FROM raw.openmeteo_archive)
    + (SELECT COUNT(*) FROM raw.fx_usd_idr)
    + (SELECT COUNT(*) FROM raw.hbkn_calendar)
    + (SELECT COUNT(*) FROM raw.info_pangan_jkt)
    + (SELECT COUNT(*) FROM raw.dki_harga_pokok_bulanan)
    + (SELECT COUNT(*) FROM raw.pihps_market_prices)
    + (SELECT COUNT(*) FROM raw.pihps_produsen_prices)
    + (SELECT COUNT(*) FROM raw.ref_bbm_esdm)
    + (SELECT COUNT(*) FROM raw.ref_bapanas_het)
    + (SELECT COUNT(*) FROM raw.ref_supply_corridor) AS total_rows
),
ins_run AS (
  INSERT INTO ops.pipeline_runs (pipeline_name, started_at, completed_at, status, rows_processed, message)
  SELECT 'wf_ingest_all_sources', now(), now(), 'SUCCESS', total_rows,
         'All 13 sources (12 raw tables) ingested cleanly'
  FROM counts
  RETURNING run_id
)
INSERT INTO ops.pipeline_watermarks (source_name, last_watermark, data_version, last_run_id, updated_at)
SELECT v.src, v.wm, v.ver, r.run_id, now()
FROM ins_run r
CROSS JOIN (VALUES
  ('raw.pihps_market_prices', (SELECT MAX(date_param) FROM raw.pihps_market_prices), '2022-01-01..2026-02-12'),
  ('raw.pihps_produsen_prices', (SELECT MAX(date_param) FROM raw.pihps_produsen_prices), '2022-01-01..2026-02-12'),
  ('raw.openmeteo_archive', (SELECT MAX(weather_date) FROM raw.openmeteo_archive), '2022-01-01..2026-02-12'),
  ('raw.openmeteo_live', (SELECT MAX(weather_date) FROM raw.openmeteo_live), 'live-forecast'),
  ('raw.bmkg_forecast', (SELECT MAX(local_datetime) FROM raw.bmkg_forecast), 'live-forecast'),
  ('raw.fx_usd_idr', (SELECT MAX(rate_date) FROM raw.fx_usd_idr), 'daily-fx'),
  ('raw.hbkn_calendar', (SELECT MAX(holiday_date) FROM raw.hbkn_calendar), '2022..2026'),
  ('raw.dki_harga_pokok_bulanan', (SELECT MAX(periode_data) FROM raw.dki_harga_pokok_bulanan), '202501..202609'),
  ('raw.ref_bbm_esdm', (SELECT MAX(valid_from) FROM raw.ref_bbm_esdm), 'scd2-v1'),
  ('raw.ref_bapanas_het', (SELECT MAX(valid_from) FROM raw.ref_bapanas_het), 'scd2-v1'),
  ('raw.ref_supply_corridor', 'COR-09', 'fdp-2024-v1')
) AS v(src, wm, ver)
ON CONFLICT (source_name) DO UPDATE
SET last_watermark = EXCLUDED.last_watermark,
    data_version = EXCLUDED.data_version,
    last_run_id = EXCLUDED.last_run_id,
    updated_at = EXCLUDED.updated_at;</sql>
      <sqlfilename/><sqlfromfile>F</sqlfromfile><useVariableSubstitution>F</useVariableSubstitution>
