<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_ingest_bmkg</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>SRC-08: Ensure raw.bmkg_forecast exists and run pl_ingest_bmkg.hpl</description>
  <extended_description/>
  <workflow_version>1.0</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/11/18 10:55:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/18 10:55:00.000</modified_date>
  <parameters/>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Ensure raw.bmkg_forecast</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>lab-postgres</connection>
      <sendOneStatement>F</sendOneStatement>
      <sql>CREATE TABLE IF NOT EXISTS raw.bmkg_forecast (
  region_key text NOT NULL,
  region_name text NOT NULL,
  adm4_code text NOT NULL,
  kotkab text,
  kecamatan text,
  desa text,
  utc_datetime text,
  local_datetime text,
  t_celsius double precision,
  hu_pct double precision,
  tp_mm double precision,
  ws_kmh double precision,
  wd text,
  tcc_pct double precision,
  weather_code integer,
  weather_desc text,
  analysis_date text,
  http_status integer,
  ingested_at timestamptz NOT NULL DEFAULT now()
);</sql>
      <sqlfilename/>
      <sqlfromfile>F</sqlfromfile>
      <useVariableSubstitution>F</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>pl_ingest_bmkg.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/raw/pl_ingest_bmkg.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>624</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Ensure raw.bmkg_forecast</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Ensure raw.bmkg_forecast</from>
      <to>pl_ingest_bmkg.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pl_ingest_bmkg.hpl</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
