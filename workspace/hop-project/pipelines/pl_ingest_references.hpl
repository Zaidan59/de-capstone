<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_ingest_references</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>SRC-10..12: Load ESDM BBM, Bapanas HET/HAP, and Supply Corridor reference CSVs into raw.*</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/25 13:35:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 13:35:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Read ref_bbm_esdm.csv</from>
      <to>Write raw.ref_bbm_esdm</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read ref_bapanas_het.csv</from>
      <to>Write raw.ref_bapanas_het</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read ref_supply_corridor.csv</from>
      <to>Write raw.ref_supply_corridor</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read ref_bbm_esdm.csv</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${PROJECT_HOME}/../data/ref_bbm_esdm.csv</filename>
    <filename_field/><rownum_field/><include_filename>N</include_filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header>
    <buffer_size>50000</buffer_size><lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result>
    <parallel>N</parallel><newline_possible>N</newline_possible><encoding>UTF-8</encoding>
    <fields>
      <field><name>bbm_id</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>jenis_bbm</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>kategori_bbm</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>harga_per_liter</name><type>Number</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>dasar_regulasi</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>valid_from</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>valid_to</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>is_current</name><type>Boolean</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>144</xloc><yloc>64</yloc></GUI>
  </transform>
  <transform>
    <name>Write raw.ref_bbm_esdm</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
      <field><column_name>bbm_id</column_name><stream_name>bbm_id</stream_name></field>
      <field><column_name>jenis_bbm</column_name><stream_name>jenis_bbm</stream_name></field>
