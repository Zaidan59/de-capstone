<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_ingest_openmeteo_live</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>SRC-05..07: Fetch Open-Meteo live forecast API into raw.openmeteo_live</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/18 14:10:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/18 14:10:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Regions &amp; Forecast URLs</from>
      <to>Fetch Open-Meteo API</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fetch Open-Meteo API</from>
      <to>Parse Daily JSON</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse Daily JSON</from>
      <to>Write raw.openmeteo_live</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Regions &amp; Forecast URLs</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>region_key</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>region_name</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>url</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>garut</item>
        <item>Kab. Garut</item>
        <item>https://api.open-meteo.com/v1/forecast?latitude=-7.2278&amp;longitude=107.9087&amp;daily=temperature_2m_max,precipitation_sum,rain_sum&amp;past_days=7&amp;forecast_days=3&amp;timezone=Asia%2FJakarta</item>
      </line>
      <line>
        <item>magelang</item>
        <item>Kab. Magelang</item>
        <item>https://api.open-meteo.com/v1/forecast?latitude=-7.4797&amp;longitude=110.2177&amp;daily=temperature_2m_max,precipitation_sum,rain_sum&amp;past_days=7&amp;forecast_days=3&amp;timezone=Asia%2FJakarta</item>
      </line>
      <line>
        <item>karawang</item>
        <item>Kab. Karawang</item>
        <item>https://api.open-meteo.com/v1/forecast?latitude=-6.3073&amp;longitude=107.3019&amp;daily=temperature_2m_max,precipitation_sum,rain_sum&amp;past_days=7&amp;forecast_days=3&amp;timezone=Asia%2FJakarta</item>
      </line>
      <line>
        <item>indramayu</item>
        <item>Kab. Indramayu</item>
        <item>https://api.open-meteo.com/v1/forecast?latitude=-6.3276&amp;longitude=108.3249&amp;daily=temperature_2m_max,precipitation_sum,rain_sum&amp;past_days=7&amp;forecast_days=3&amp;timezone=Asia%2FJakarta</item>
      </line>
      <line>
        <item>brebes</item>
        <item>Kab. Brebes</item>
        <item>https://api.open-meteo.com/v1/forecast?latitude=-6.8706&amp;longitude=109.0369&amp;daily=temperature_2m_max,precipitation_sum,rain_sum&amp;past_days=7&amp;forecast_days=3&amp;timezone=Asia%2FJakarta</item>
      </line>
      <line>
        <item>dki_jakarta</item>
        <item>DKI Jakarta</item>
        <item>https://api.open-meteo.com/v1/forecast?latitude=-6.2088&amp;longitude=106.8456&amp;daily=temperature_2m_max,precipitation_sum,rain_sum&amp;past_days=7&amp;forecast_days=3&amp;timezone=Asia%2FJakarta</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fetch Open-Meteo API</name>
    <type>Rest</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>TEXT PLAIN</applicationType>
    <connectionTimeout>15000</connectionTimeout>
    <readTimeout>15000</readTimeout>
    <retryTimes>3</retryTimes>
    <retryDelayMs>2000</retryDelayMs>
    <method>GET</method>
    <url/>
    <urlInField>Y</urlInField>
    <dynamicMethod>N</dynamicMethod>
    <methodFieldName/>
    <urlField>url</urlField>
    <bodyField/>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <proxyHost/>
    <proxyPort/>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <ignoreSsl>N</ignoreSsl>
    <headers/>
    <parameters/>
    <matrixParameters/>
    <result>
      <name>result</name>
      <code>http_status</code>
      <response_time/>
      <response_header/>
    </result>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Parse Daily JSON</name>
    <type>JsonInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>Y</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name/>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>weather_date</name>
        <path>$.daily.time[*]</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>temperature_2m_max_c</name>
        <path>$.daily.temperature_2m_max[*]</path>
        <type>Number</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>precipitation_sum_mm</name>
        <path>$.daily.precipitation_sum[*]</path>
        <type>Number</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>rain_sum_mm</name>
        <path>$.daily.rain_sum[*]</path>
        <type>Number</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>Y</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField>result</valueField>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write raw.openmeteo_live</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
      <field>
        <column_name>region_key</column_name>
        <stream_name>region_key</stream_name>
      </field>
      <field>
        <column_name>region_name</column_name>
        <stream_name>region_name</stream_name>
      </field>
      <field>
        <column_name>weather_date</column_name>
        <stream_name>weather_date</stream_name>
      </field>
      <field>
        <column_name>temperature_2m_max_c</column_name>
        <stream_name>temperature_2m_max_c</stream_name>
      </field>
      <field>
        <column_name>precipitation_sum_mm</column_name>
        <stream_name>precipitation_sum_mm</stream_name>
      </field>
      <field>
        <column_name>rain_sum_mm</column_name>
        <stream_name>rain_sum_mm</stream_name>
      </field>
      <field>
        <column_name>http_status</column_name>
        <stream_name>http_status</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>raw</schema>
    <table>openmeteo_live</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
