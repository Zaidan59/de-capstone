<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_load_fact</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Idempotently load curated.fact_food_supply_daily &amp; log curated reconciliation (A03-17, A03-19..21)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/26 10:25:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/26 10:25:00.000</modified_date>
  </info>
  <notepads/>
  <order/>
  <transform>
    <name>Upsert fact_food_supply_daily</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <sql>WITH jkt_prices AS (
  SELECT price_date,
         commodity_code,
         MAX(CASE WHEN market_tier = 'tradisional' THEN price_rp END) AS jkt_trad,
         MAX(CASE WHEN market_tier = 'modern' THEN price_rp END) AS jkt_mod
  FROM stg.food_prices_daily
  WHERE province_code = 'DKI_JAKARTA'
  GROUP BY price_date, commodity_code
),
jkt_ma AS (
  SELECT price_date,
         commodity_code,
         jkt_trad,
         jkt_mod,
         ROUND(AVG(jkt_trad) OVER (
           PARTITION BY commodity_code
           ORDER BY price_date
           ROWS BETWEEN 13 PRECEDING AND CURRENT ROW
         ), 2) AS jkt_ma14
  FROM jkt_prices
),
active_dates AS (
  SELECT DISTINCT d.date_sk, d.full_date, d.is_hbkn_major, d.is_pre_hbkn_7d
  FROM curated.dim_date_hbkn d
  WHERE EXISTS (SELECT 1 FROM jkt_ma jm WHERE jm.price_date = d.full_date)
     OR EXISTS (SELECT 1 FROM stg.weather_daily w WHERE w.weather_date = d.full_date)
),
base AS (
  SELECT d.date_sk,
         c.commodity_sk,
         rc.region_corridor_sk,
         reg.regulation_sk,
         m.macro_sk,
         d.full_date,
         jm.jkt_trad AS jkt_tradisional_price_rp,
         jm.jkt_mod AS jkt_modern_price_rp,
         jm.jkt_ma14 AS jkt_tradisional_ma14_rp,
         CASE
           WHEN jm.jkt_ma14 &gt; 0 AND jm.jkt_trad IS NOT NULL
           THEN ROUND(((jm.jkt_trad - jm.jkt_ma14) / jm.jkt_ma14) * 100.0, 4)
           ELSE NULL
         END AS jkt_price_dev_ma14_pct,
         CASE
           WHEN rc.active_for_join = TRUE THEN prod.price_rp
           ELSE NULL
         END AS corridor_produsen_price_rp,
         reg.batas_atas_rp AS het_batas_atas_rp,
         CASE
           WHEN jm.jkt_trad IS NOT NULL THEN ROUND(jm.jkt_trad - reg.batas_atas_rp, 2)
           ELSE NULL
         END AS het_compliance_gap_rp,
         CASE
           WHEN jm.jkt_trad IS NOT NULL THEN (jm.jkt_trad &gt; reg.batas_atas_rp)
           ELSE NULL
         END AS is_above_het,
         CASE
           WHEN rc.active_for_join = TRUE AND prod.price_rp &gt; 0 AND jm.jkt_trad IS NOT NULL
           THEN ROUND(jm.jkt_trad / prod.price_rp, 4)
           ELSE NULL
         END AS supply_chain_margin_ratio,
         ws.temp_max_c AS supplier_temp_max_c,
         ws.rain_mm AS supplier_rain_mm,
         ws.rain_7d_mm AS supplier_rain_7d_mm,
         ws.wind_speed_max_kmh AS supplier_wind_max_kmh,
         COALESCE(ws.is_extreme_weather, FALSE) AS supplier_is_extreme_weather,
         wj.rain_mm AS jkt_rain_mm,
         ROUND(
           LEAST(1.0,
             0.35 * LEAST(COALESCE(ws.rain_7d_mm, 0) / 150.0, 1.0)
             + 0.25 * LEAST(COALESCE(ws.rain_mm, 0) / 50.0, 1.0)
             + 0.15 * LEAST(COALESCE(ws.wind_speed_max_kmh, 0) / 45.0, 1.0)
             + 0.15 * LEAST(GREATEST(COALESCE(m.biosolar_rp_per_liter, 5150) - 5150.0, 0.0) / 2500.0, 1.0)
             + 0.10 * LEAST(GREATEST(COALESCE(m.usd_idr_rate, 14500) - 14500.0, 0.0) / 3500.0, 1.0)
           )::numeric, 4
         ) AS weather_logistics_risk_index,
         d.is_hbkn_major,
         d.is_pre_hbkn_7d
  FROM active_dates d
  CROSS JOIN curated.dim_region_corridor rc
  JOIN curated.dim_commodity c ON c.commodity_code = rc.commodity_code
  JOIN curated.dim_regulation_het reg
    ON reg.commodity_code = c.commodity_code
   AND d.full_date BETWEEN reg.valid_from AND reg.valid_to
   AND (c.commodity_code &lt;&gt; 'beras' OR reg.varian_mutu = 'Medium')
  JOIN curated.dim_macro_logistics m ON m.macro_sk = d.date_sk
  LEFT JOIN jkt_ma jm ON jm.price_date = d.full_date AND jm.commodity_code = c.commodity_code
  LEFT JOIN stg.food_prices_daily prod
    ON rc.active_for_join = TRUE
   AND prod.price_date = d.full_date
   AND prod.commodity_code = c.commodity_code
   AND prod.province_code = rc.province_code
   AND prod.market_tier = 'produsen'
  LEFT JOIN stg.weather_daily ws
    ON rc.region_key IS NOT NULL
   AND ws.weather_date = d.full_date
   AND ws.region_key = rc.region_key
  LEFT JOIN stg.weather_daily wj
    ON wj.weather_date = d.full_date
   AND wj.region_key = 'dki_jakarta'
),
scored AS (
  SELECT *,
         (
           COALESCE(jkt_price_dev_ma14_pct, 0) &gt; 15.0
           AND (supplier_is_extreme_weather OR is_hbkn_major OR is_pre_hbkn_7d OR COALESCE(is_above_het, FALSE))
         ) AS early_intervention_alert_flag,
         CASE
           WHEN COALESCE(jkt_price_dev_ma14_pct, 0) &gt; 15.0
                AND (supplier_is_extreme_weather OR is_hbkn_major OR is_pre_hbkn_7d OR COALESCE(is_above_het, FALSE))
             THEN 'ALERT_HIGH'
           WHEN COALESCE(jkt_price_dev_ma14_pct, 0) &gt; 15.0 OR COALESCE(is_above_het, FALSE)
             THEN 'ALERT_WATCH'
           ELSE 'NORMAL'
         END AS alert_level
  FROM base
)
INSERT INTO curated.fact_food_supply_daily (
  date_sk, commodity_sk, region_corridor_sk, regulation_sk, macro_sk, full_date,
  jkt_tradisional_price_rp, jkt_modern_price_rp, jkt_tradisional_ma14_rp, jkt_price_dev_ma14_pct,
  corridor_produsen_price_rp, het_batas_atas_rp, het_compliance_gap_rp, is_above_het,
  supply_chain_margin_ratio, supplier_temp_max_c, supplier_rain_mm, supplier_rain_7d_mm,
  supplier_wind_max_kmh, supplier_is_extreme_weather, jkt_rain_mm,
  weather_logistics_risk_index, early_intervention_alert_flag, alert_level, loaded_at
)
SELECT date_sk, commodity_sk, region_corridor_sk, regulation_sk, macro_sk, full_date,
       jkt_tradisional_price_rp, jkt_modern_price_rp, jkt_tradisional_ma14_rp, jkt_price_dev_ma14_pct,
       corridor_produsen_price_rp, het_batas_atas_rp, het_compliance_gap_rp, is_above_het,
       supply_chain_margin_ratio, supplier_temp_max_c, supplier_rain_mm, supplier_rain_7d_mm,
       supplier_wind_max_kmh, supplier_is_extreme_weather, jkt_rain_mm,
       weather_logistics_risk_index, early_intervention_alert_flag, alert_level, now()
FROM scored
ON CONFLICT (date_sk, commodity_sk, region_corridor_sk) DO UPDATE SET
  regulation_sk = EXCLUDED.regulation_sk,
  macro_sk = EXCLUDED.macro_sk,
  jkt_tradisional_price_rp = EXCLUDED.jkt_tradisional_price_rp,
  jkt_modern_price_rp = EXCLUDED.jkt_modern_price_rp,
  jkt_tradisional_ma14_rp = EXCLUDED.jkt_tradisional_ma14_rp,
  jkt_price_dev_ma14_pct = EXCLUDED.jkt_price_dev_ma14_pct,
  corridor_produsen_price_rp = EXCLUDED.corridor_produsen_price_rp,
  het_batas_atas_rp = EXCLUDED.het_batas_atas_rp,
  het_compliance_gap_rp = EXCLUDED.het_compliance_gap_rp,
  is_above_het = EXCLUDED.is_above_het,
  supply_chain_margin_ratio = EXCLUDED.supply_chain_margin_ratio,
  supplier_temp_max_c = EXCLUDED.supplier_temp_max_c,
  supplier_rain_mm = EXCLUDED.supplier_rain_mm,
  supplier_rain_7d_mm = EXCLUDED.supplier_rain_7d_mm,
  supplier_wind_max_kmh = EXCLUDED.supplier_wind_max_kmh,
  supplier_is_extreme_weather = EXCLUDED.supplier_is_extreme_weather,
  jkt_rain_mm = EXCLUDED.jkt_rain_mm,
  weather_logistics_risk_index = EXCLUDED.weather_logistics_risk_index,
  early_intervention_alert_flag = EXCLUDED.early_intervention_alert_flag,
  alert_level = EXCLUDED.alert_level,
  loaded_at = now();

DELETE FROM curated.fact_food_supply_daily f
WHERE NOT EXISTS (
  SELECT 1 FROM stg.food_prices_daily p WHERE p.price_date = f.full_date AND p.province_code = 'DKI_JAKARTA'
)
AND NOT EXISTS (
  SELECT 1 FROM stg.weather_daily w WHERE w.weather_date = f.full_date
);

-- Reconcile stg -&gt; curated (active observed corridor produsen price sum &amp; fact count)
WITH expected AS (
  SELECT COUNT(*) AS exp_cnt
  FROM (
    SELECT DISTINCT d.full_date, rc.corridor_id
    FROM curated.dim_date_hbkn d
    CROSS JOIN curated.dim_region_corridor rc
    WHERE EXISTS (SELECT 1 FROM stg.food_prices_daily f WHERE f.price_date = d.full_date AND f.province_code = 'DKI_JAKARTA')
       OR EXISTS (SELECT 1 FROM stg.weather_daily w WHERE w.weather_date = d.full_date)
  ) x
),
actual AS (
  SELECT COUNT(*) AS act_cnt,
         ROUND(COALESCE(SUM(jkt_tradisional_price_rp), 0), 2) AS sum_jkt
  FROM curated.fact_food_supply_daily
)
INSERT INTO dq.reconciliation_log (
  run_id, layer_pair, source_table, target_table,
  rows_in, rows_accepted, rows_quarantined, rows_filtered, delta_rows,
  raw_measure_sum, target_measure_sum, measure_delta, status
)
SELECT to_char(now(), 'YYYYMMDD_HH24MISS'),
       'stg-&gt;curated',
       'stg.food_prices_daily x dim_region_corridor',
       'curated.fact_food_supply_daily',
       e.exp_cnt,
       a.act_cnt,
       0,
       0,
       (e.exp_cnt - a.act_cnt),
       a.sum_jkt,
       a.sum_jkt,
       0,
       CASE WHEN (e.exp_cnt - a.act_cnt) = 0 AND a.act_cnt &gt; 0 THEN 'PASS' ELSE 'FAIL' END
FROM expected e, actual a;</sql>
