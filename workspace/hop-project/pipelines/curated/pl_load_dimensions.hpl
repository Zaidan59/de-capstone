<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_load_dimensions</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Idempotently upsert all 5 Star Schema dimensions into curated.dim_* (A03-16)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/26 10:25:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/26 10:25:00.000</modified_date>
  </info>
  <notepads/>
  <order/>
  <transform>
    <name>Upsert 5 Curated Dimensions</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <sql>-- 1. dim_commodity (5 strategic commodities)
INSERT INTO curated.dim_commodity (commodity_code, commodity_name, unit, is_strategic, updated_at)
VALUES
  ('beras', 'Beras', 'Rp/kg', TRUE, now()),
  ('cabai_rawit_merah', 'Cabai Rawit Merah', 'Rp/kg', TRUE, now()),
  ('cabai_merah_keriting', 'Cabai Merah Keriting', 'Rp/kg', TRUE, now()),
  ('bawang_merah', 'Bawang Merah', 'Rp/kg', TRUE, now()),
  ('bawang_putih', 'Bawang Putih', 'Rp/kg', TRUE, now())
ON CONFLICT (commodity_code) DO UPDATE SET
  commodity_name = EXCLUDED.commodity_name,
  unit = EXCLUDED.unit,
  is_strategic = EXCLUDED.is_strategic,
  updated_at = now();

-- 2. dim_region_corridor (COR-01..09 from raw.ref_supply_corridor)
INSERT INTO curated.dim_region_corridor (
  corridor_id, region_key, region_name, province_code, province_name,
  commodity_code, pasar_tujuan, corridor_type, verification_status,
  active_for_join, latitude_ref, longitude_ref, notes, updated_at
)
SELECT corridor_id,
       NULLIF(lower(region_code), ''),
       COALESCE(NULLIF(kabupaten_sentra, ''), 'Unresolved Origin'),
       CASE provinsi_sentra
         WHEN 'Jawa Barat' THEN 'JAWA_BARAT'
         WHEN 'Jawa Tengah' THEN 'JAWA_TENGAH'
         ELSE NULL
       END,
       NULLIF(provinsi_sentra, ''),
       commodity_code,
       pasar_tujuan,
       corridor_type,
       verification_status,
       COALESCE(active_for_join, FALSE),
       latitude_ref::numeric(9,5),
       longitude_ref::numeric(9,5),
       notes,
       now()
FROM raw.ref_supply_corridor
ON CONFLICT (corridor_id) DO UPDATE SET
  region_key = EXCLUDED.region_key,
  region_name = EXCLUDED.region_name,
  province_code = EXCLUDED.province_code,
  province_name = EXCLUDED.province_name,
  commodity_code = EXCLUDED.commodity_code,
  pasar_tujuan = EXCLUDED.pasar_tujuan,
  corridor_type = EXCLUDED.corridor_type,
  verification_status = EXCLUDED.verification_status,
  active_for_join = EXCLUDED.active_for_join,
  latitude_ref = EXCLUDED.latitude_ref,
  longitude_ref = EXCLUDED.longitude_ref,
  notes = EXCLUDED.notes,
  updated_at = now();

-- 3. dim_date_hbkn (continuous calendar covering 2022-01-01 through max observed/forecast date)
WITH bounds AS (
  SELECT DATE '2022-01-01' AS min_dt,
         GREATEST(
           COALESCE((SELECT MAX(price_date) FROM stg.food_prices_daily), DATE '2026-02-12'),
           COALESCE((SELECT MAX(weather_date) FROM stg.weather_daily), DATE '2026-11-28')
         ) AS max_dt
),
cal AS (
  SELECT gs::date AS full_date
  FROM bounds, generate_series(bounds.min_dt, bounds.max_dt, interval '1 day') AS gs
),
major_dates AS (
  SELECT holiday_date FROM stg.hbkn_daily WHERE is_hbkn_major = TRUE
)
INSERT INTO curated.dim_date_hbkn (
  date_sk, full_date, year_num, month_num, day_num, day_of_week,
  is_weekend, is_holiday, holiday_names, hbkn_category, is_hbkn_major, is_pre_hbkn_7d
)
SELECT to_char(c.full_date, 'YYYYMMDD')::integer AS date_sk,
       c.full_date,
       EXTRACT(YEAR FROM c.full_date)::integer,
       EXTRACT(MONTH FROM c.full_date)::integer,
       EXTRACT(DAY FROM c.full_date)::integer,
       EXTRACT(ISODOW FROM c.full_date)::integer,
       (EXTRACT(ISODOW FROM c.full_date) IN (6, 7)),
       (h.holiday_date IS NOT NULL),
       h.holiday_names,
       COALESCE(h.hbkn_category, 'NONE'),
       COALESCE(h.is_hbkn_major, FALSE),
       EXISTS (
         SELECT 1 FROM major_dates m
         WHERE m.holiday_date BETWEEN c.full_date + 1 AND c.full_date + 7
       )
FROM cal c
LEFT JOIN stg.hbkn_daily h ON h.holiday_date = c.full_date
ON CONFLICT (date_sk) DO UPDATE SET
  is_holiday = EXCLUDED.is_holiday,
  holiday_names = EXCLUDED.holiday_names,
  hbkn_category = EXCLUDED.hbkn_category,
  is_hbkn_major = EXCLUDED.is_hbkn_major,
  is_pre_hbkn_7d = EXCLUDED.is_pre_hbkn_7d;

-- 4. dim_regulation_het (SCD Type-2 Bapanas HET/HAP)
INSERT INTO curated.dim_regulation_het (
  reg_id, commodity_code, varian_mutu, jenis_batas,
  batas_bawah_rp, batas_atas_rp, dasar_regulasi, valid_from, valid_to, is_current
)
SELECT reg_id,
       CASE komoditas
         WHEN 'Beras' THEN 'beras'
         WHEN 'Cabai Rawit Merah' THEN 'cabai_rawit_merah'
         WHEN 'Cabai Merah Keriting' THEN 'cabai_merah_keriting'
         WHEN 'Bawang Merah' THEN 'bawang_merah'
         WHEN 'Bawang Putih' THEN 'bawang_putih'
       END,
       varian_mutu,
       jenis_batas,
       batas_bawah_rp::numeric(12,2),
       batas_atas_rp::numeric(12,2),
       dasar_regulasi,
       valid_from::date,
       valid_to::date,
       COALESCE(is_current, FALSE)
FROM raw.ref_bapanas_het
ON CONFLICT (reg_id) DO UPDATE SET
  commodity_code = EXCLUDED.commodity_code,
  varian_mutu = EXCLUDED.varian_mutu,
  jenis_batas = EXCLUDED.jenis_batas,
  batas_bawah_rp = EXCLUDED.batas_bawah_rp,
  batas_atas_rp = EXCLUDED.batas_atas_rp,
  dasar_regulasi = EXCLUDED.dasar_regulasi,
  valid_from = EXCLUDED.valid_from,
  valid_to = EXCLUDED.valid_to,
  is_current = EXCLUDED.is_current;

-- 5. dim_macro_logistics (BBM SCD Type-2 + forward-filled daily FX)
WITH bbm_daily AS (
  SELECT d.date_sk,
         d.full_date,
         MAX(CASE WHEN b.jenis_bbm = 'Biosolar' THEN b.harga_per_liter END)::numeric(10,2) AS biosolar,
         MAX(CASE WHEN b.jenis_bbm = 'Pertalite' THEN b.harga_per_liter END)::numeric(10,2) AS pertalite,
         MAX(b.dasar_regulasi) AS reg
  FROM curated.dim_date_hbkn d
  JOIN raw.ref_bbm_esdm b ON d.full_date BETWEEN b.valid_from::date AND b.valid_to::date
  GROUP BY d.date_sk, d.full_date
),
fx_filled AS (
  SELECT bd.*,
         (SELECT f.usd_idr_rate FROM stg.fx_daily f WHERE f.rate_date &lt;= bd.full_date ORDER BY f.rate_date DESC LIMIT 1) AS usd_idr_rate
  FROM bbm_daily bd
)
INSERT INTO curated.dim_macro_logistics (
  macro_sk, full_date, usd_idr_rate, biosolar_rp_per_liter, pertalite_rp_per_liter, bbm_regulasi, updated_at
)
SELECT date_sk, full_date, usd_idr_rate, biosolar, pertalite, reg, now()
FROM fx_filled
ON CONFLICT (macro_sk) DO UPDATE SET
  usd_idr_rate = EXCLUDED.usd_idr_rate,
  biosolar_rp_per_liter = EXCLUDED.biosolar_rp_per_liter,
  pertalite_rp_per_liter = EXCLUDED.pertalite_rp_per_liter,
  bbm_regulasi = EXCLUDED.bbm_regulasi,
  updated_at = now();</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments/>
    <attributes/>
    <GUI><xloc>224</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>