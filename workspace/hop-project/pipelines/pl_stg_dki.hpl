<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_dki</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>A03-08: raw harga DKI bulanan dan Info Pangan Jakarta ke stg</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/26 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/26 12:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read price_dki_monthly</from><to>Write price_dki_monthly</to><enabled>Y</enabled></hop>
    <hop><from>Read price_info_pangan_jkt</from><to>Write price_info_pangan_jkt</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read price_dki_monthly</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <sql>SELECT &apos;SRC-04&apos; AS source_id, stg.safe_month(periode_data) AS period_month, trim(wilayah) AS region_name, trim(komoditas) AS commodity_raw,
 regexp_replace(regexp_replace(upper(trim(komoditas)), &apos;\s+&apos;, &apos; &apos;, &apos;g&apos;), &apos;^(BERAS MUNCUL) \.I$&apos;, &apos;\1 I&apos;) AS commodity_std,
 harga_raw AS price_raw, stg.safe_num(harga_raw) AS price_rp,
 CASE WHEN harga_raw IS NULL OR trim(harga_raw) = &apos;&apos; THEN &apos;EMPTY&apos; WHEN stg.safe_num(harga_raw) IS NULL THEN &apos;NON_NUMERIC&apos; WHEN stg.safe_num(harga_raw) &lt;= 0 THEN &apos;NONPOSITIVE&apos; ELSE &apos;OK&apos; END AS price_status,
 (SELECT max(run_id) FROM ops.pipeline_runs WHERE pipeline_name = &apos;wf_ingest_all_sources&apos;) AS run_id, ingested_at AS raw_ingested_at
FROM raw.dki_harga_pokok_bulanan</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>144</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <name>Write price_dki_monthly</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
        <field><column_name>source_id</column_name><stream_name>source_id</stream_name></field>
        <field><column_name>period_month</column_name><stream_name>period_month</stream_name></field>
        <field><column_name>region_name</column_name><stream_name>region_name</stream_name></field>
        <field><column_name>commodity_raw</column_name><stream_name>commodity_raw</stream_name></field>
        <field><column_name>commodity_std</column_name><stream_name>commodity_std</stream_name></field>
        <field><column_name>price_raw</column_name><stream_name>price_raw</stream_name></field>
        <field><column_name>price_rp</column_name><stream_name>price_rp</stream_name></field>
        <field><column_name>price_status</column_name><stream_name>price_status</stream_name></field>
        <field><column_name>run_id</column_name><stream_name>run_id</stream_name></field>
        <field><column_name>raw_ingested_at</column_name><stream_name>raw_ingested_at</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>stg</schema>
    <table>price_dki_monthly</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>80</yloc></GUI>
  </transform>  <transform>
    <name>Read price_info_pangan_jkt</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <sql>SELECT &apos;SRC-04&apos; AS source_id, CASE WHEN trim(periode_data) ~ &apos;^[0-9]{4}(\.0+){0,1}$&apos; THEN substr(trim(periode_data),1,4)::int END AS period_year,
 regexp_replace(upper(trim(komoditas)), &apos;\s+&apos;, &apos; &apos;, &apos;g&apos;) AS commodity_std, harga_rata_rata_raw AS price_raw,
 stg.safe_num(replace(harga_rata_rata_raw, &apos;,&apos;, &apos;&apos;)) AS price_rp, (SELECT max(run_id) FROM ops.pipeline_runs WHERE pipeline_name = &apos;wf_ingest_all_sources&apos;) AS run_id, ingested_at AS raw_ingested_at
FROM raw.info_pangan_jkt</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>144</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform>
    <name>Write price_info_pangan_jkt</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
        <field><column_name>source_id</column_name><stream_name>source_id</stream_name></field>
        <field><column_name>period_year</column_name><stream_name>period_year</stream_name></field>
        <field><column_name>commodity_std</column_name><stream_name>commodity_std</stream_name></field>
        <field><column_name>price_raw</column_name><stream_name>price_raw</stream_name></field>
        <field><column_name>price_rp</column_name><stream_name>price_rp</stream_name></field>
        <field><column_name>run_id</column_name><stream_name>run_id</stream_name></field>
        <field><column_name>raw_ingested_at</column_name><stream_name>raw_ingested_at</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>stg</schema>
    <table>price_info_pangan_jkt</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>192</yloc></GUI>
  </transform>  <transform_error_handling/>
  <attributes/>
</pipeline>