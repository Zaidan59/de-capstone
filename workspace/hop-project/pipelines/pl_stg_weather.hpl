<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_weather</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>A03-08: raw Open-Meteo (arsip+live) dan BMKG ke stg</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/26 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/26 12:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read weather_daily</from><to>Write weather_daily</to><enabled>Y</enabled></hop>
    <hop><from>Read bmkg_forecast</from><to>Write bmkg_forecast</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read weather_daily</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <sql>SELECT CASE WHEN r.region_key IN (&apos;garut&apos;,&apos;magelang&apos;) THEN &apos;SRC-05&apos; WHEN r.region_key IN (&apos;karawang&apos;,&apos;indramayu&apos;) THEN &apos;SRC-06&apos; WHEN r.region_key IN (&apos;brebes&apos;,&apos;dki_jakarta&apos;) THEN &apos;SRC-07&apos; ELSE &apos;SRC-05..07&apos; END AS source_id,
 r.region_key AS region_key, stg.safe_date(r.weather_date) AS weather_date, round(r.temp::numeric, 2) AS temp_max_c, round(r.precip::numeric, 2) AS precip_mm, round(r.rain::numeric, 2) AS rain_mm,
 r.origin AS data_origin, r.http_status AS http_status, (SELECT max(run_id) FROM ops.pipeline_runs WHERE pipeline_name = &apos;wf_ingest_all_sources&apos;) AS run_id, r.ingested_at AS raw_ingested_at
FROM (
 SELECT regexp_replace(lower(trim(source_file)), &apos;^cuaca\s+|\.csv$&apos;, &apos;&apos;, &apos;g&apos;) AS region_key, weather_date, temperature_2m_max_c AS temp, precipitation_sum_mm AS precip, rain_sum_mm AS rain, &apos;archive&apos;::text AS origin, NULL::int AS http_status, ingested_at FROM raw.openmeteo_archive
 UNION ALL
 SELECT lower(trim(region_key)), weather_date, temperature_2m_max_c, precipitation_sum_mm, rain_sum_mm, &apos;live&apos;::text, http_status, ingested_at FROM raw.openmeteo_live
) r</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>144</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <name>Write weather_daily</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
        <field><column_name>source_id</column_name><stream_name>source_id</stream_name></field>
        <field><column_name>region_key</column_name><stream_name>region_key</stream_name></field>
        <field><column_name>weather_date</column_name><stream_name>weather_date</stream_name></field>
        <field><column_name>temp_max_c</column_name><stream_name>temp_max_c</stream_name></field>
        <field><column_name>precip_mm</column_name><stream_name>precip_mm</stream_name></field>
        <field><column_name>rain_mm</column_name><stream_name>rain_mm</stream_name></field>
        <field><column_name>data_origin</column_name><stream_name>data_origin</stream_name></field>
        <field><column_name>http_status</column_name><stream_name>http_status</stream_name></field>
        <field><column_name>run_id</column_name><stream_name>run_id</stream_name></field>
        <field><column_name>raw_ingested_at</column_name><stream_name>raw_ingested_at</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>stg</schema>
    <table>weather_daily</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>80</yloc></GUI>
  </transform>  <transform>
    <name>Read bmkg_forecast</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <sql>SELECT &apos;SRC-08&apos; AS source_id, lower(trim(region_key)) AS region_key, adm4_code AS adm4_code, kotkab AS regency_name, stg.safe_ts(local_datetime) AS local_datetime, stg.safe_ts(utc_datetime) AS utc_datetime,
 t_celsius AS temp_c, hu_pct AS humidity_pct, tp_mm AS rain_mm, ws_kmh AS wind_kmh, tcc_pct AS cloud_pct, weather_code AS weather_code, weather_desc AS weather_desc, http_status AS http_status,
 (SELECT max(run_id) FROM ops.pipeline_runs WHERE pipeline_name = &apos;wf_ingest_all_sources&apos;) AS run_id, ingested_at AS raw_ingested_at
FROM raw.bmkg_forecast</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>144</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform>
    <name>Write bmkg_forecast</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
        <field><column_name>source_id</column_name><stream_name>source_id</stream_name></field>
        <field><column_name>region_key</column_name><stream_name>region_key</stream_name></field>
        <field><column_name>adm4_code</column_name><stream_name>adm4_code</stream_name></field>
        <field><column_name>regency_name</column_name><stream_name>regency_name</stream_name></field>
        <field><column_name>local_datetime</column_name><stream_name>local_datetime</stream_name></field>
        <field><column_name>utc_datetime</column_name><stream_name>utc_datetime</stream_name></field>
        <field><column_name>temp_c</column_name><stream_name>temp_c</stream_name></field>
        <field><column_name>humidity_pct</column_name><stream_name>humidity_pct</stream_name></field>
        <field><column_name>rain_mm</column_name><stream_name>rain_mm</stream_name></field>
        <field><column_name>wind_kmh</column_name><stream_name>wind_kmh</stream_name></field>
        <field><column_name>cloud_pct</column_name><stream_name>cloud_pct</stream_name></field>
        <field><column_name>weather_code</column_name><stream_name>weather_code</stream_name></field>
        <field><column_name>weather_desc</column_name><stream_name>weather_desc</stream_name></field>
        <field><column_name>http_status</column_name><stream_name>http_status</stream_name></field>
        <field><column_name>run_id</column_name><stream_name>run_id</stream_name></field>
        <field><column_name>raw_ingested_at</column_name><stream_name>raw_ingested_at</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>stg</schema>
    <table>bmkg_forecast</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>192</yloc></GUI>
  </transform>  <transform_error_handling/>
  <attributes/>
</pipeline>