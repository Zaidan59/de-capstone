<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_ingest_pihps_mysql</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>SRC-01..02: Extract 10 strategic PIHPS tables (tradisional &amp; modern) from MySQL labsource into raw.pihps_market_prices</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/18 14:10:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/18 14:10:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Read PIHPS MySQL (Tradisional + Modern)</from>
      <to>Write raw.pihps_market_prices</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read PIHPS MySQL (Tradisional + Modern)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>lab-mysql</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT 'tradisional' AS market_tier, 'beras' AS commodity, date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_tradisional_beras
UNION ALL
SELECT 'tradisional', 'cabai_rawit', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_tradisional_cabai_rawit
UNION ALL
SELECT 'tradisional', 'cabai_merah', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_tradisional_cabai_merah
UNION ALL
SELECT 'tradisional', 'bawang_merah', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_tradisional_bawang_merah
UNION ALL
SELECT 'tradisional', 'bawang_putih', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_tradisional_bawang_putih
UNION ALL
SELECT 'modern', 'beras', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_modern_beras
UNION ALL
SELECT 'modern', 'cabai_rawit', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_modern_cabai_rawit
UNION ALL
SELECT 'modern', 'cabai_merah', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_modern_cabai_merah
UNION ALL
SELECT 'modern', 'bawang_merah', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_modern_bawang_merah
UNION ALL
SELECT 'modern', 'bawang_putih', date_param, dki_jakarta, jawa_barat, jawa_tengah FROM src_modern_bawang_putih</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write raw.pihps_market_prices</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
      <field>
        <column_name>market_tier</column_name>
        <stream_name>market_tier</stream_name>
      </field>
      <field>
        <column_name>commodity</column_name>
        <stream_name>commodity</stream_name>
      </field>
      <field>
        <column_name>date_param</column_name>
        <stream_name>date_param</stream_name>
      </field>
      <field>
        <column_name>dki_jakarta</column_name>
        <stream_name>dki_jakarta</stream_name>
      </field>
      <field>
        <column_name>jawa_barat</column_name>
        <stream_name>jawa_barat</stream_name>
      </field>
      <field>
        <column_name>jawa_tengah</column_name>
        <stream_name>jawa_tengah</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>raw</schema>
    <table>pihps_market_prices</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
