<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_weather</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Stage &amp; combine Open-Meteo archive/live + BMKG daily weather into stg.weather_daily with 7d rolling rain</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/26 10:22:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/26 10:22:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Read Weather Combined &amp; Clean</from>
      <to>Write stg.weather_daily</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Weather Combined &amp; Clean</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH archive_norm AS (
  SELECT weather_date::date AS weather_date,
         replace(replace(source_file, 'cuaca ', ''), '.csv', '') AS region_key,
         CASE replace(replace(source_file, 'cuaca ', ''), '.csv', '')
           WHEN 'garut' THEN 'Kab. Garut'
           WHEN 'magelang' THEN 'Kab. Magelang'
           WHEN 'karawang' THEN 'Kab. Karawang'
           WHEN 'indramayu' THEN 'Kab. Indramayu'
           WHEN 'brebes' THEN 'Kab. Brebes'
           WHEN 'dki_jakarta' THEN 'DKI Jakarta'
         END AS region_name,
         ROUND(temperature_2m_max_c::numeric, 2) AS temp_max_c,
         NULL::numeric(6,2) AS temp_avg_c,
         ROUND(precipitation_sum_mm::numeric, 2) AS precipitation_mm,
         ROUND(rain_sum_mm::numeric, 2) AS rain_mm,
         NULL::numeric(6,2) AS wind_speed_max_kmh,
         NULL::numeric(5,2) AS humidity_avg_pct,
         'SRC-05_OPENMETEO_ARCHIVE' AS source_system,
         1 AS prio
  FROM raw.openmeteo_archive
  WHERE weather_date IS NOT NULL
    AND temperature_2m_max_c IS NOT NULL
    AND precipitation_sum_mm &gt;= 0
    AND rain_sum_mm &gt;= 0
),
bmkg_daily AS (
  SELECT left(local_datetime, 10)::date AS weather_date,
         region_key,
         region_name,
         ROUND(MAX(t_celsius)::numeric, 2) AS temp_max_c,
         ROUND(AVG(t_celsius)::numeric, 2) AS temp_avg_c,
         ROUND(SUM(tp_mm)::numeric, 2) AS precipitation_mm,
         ROUND(SUM(tp_mm)::numeric, 2) AS rain_mm,
         ROUND(MAX(ws_kmh)::numeric, 2) AS wind_speed_max_kmh,
         ROUND(AVG(hu_pct)::numeric, 2) AS humidity_avg_pct,
         'SRC-08_BMKG_API' AS source_system,
         3 AS prio
  FROM raw.bmkg_forecast
  WHERE local_datetime IS NOT NULL
    AND t_celsius IS NOT NULL AND t_celsius NOT IN (8888, 9999)
    AND tp_mm IS NOT NULL AND tp_mm NOT IN (8888, 9999) AND tp_mm &gt;= 0
    AND (hu_pct IS NULL OR (hu_pct NOT IN (8888, 9999) AND hu_pct BETWEEN 0 AND 100))
    AND (ws_kmh IS NULL OR (ws_kmh NOT IN (8888, 9999) AND ws_kmh &gt;= 0))
  GROUP BY left(local_datetime, 10)::date, region_key, region_name
),
live_norm AS (
  SELECT l.weather_date::date AS weather_date,
         l.region_key,
         l.region_name,
         ROUND(l.temperature_2m_max_c::numeric, 2) AS temp_max_c,
         b.temp_avg_c,
         ROUND(l.precipitation_sum_mm::numeric, 2) AS precipitation_mm,
         ROUND(l.rain_sum_mm::numeric, 2) AS rain_mm,
         b.wind_speed_max_kmh,
         b.humidity_avg_pct,
         'SRC-06_OPENMETEO_LIVE' AS source_system,
         2 AS prio
  FROM raw.openmeteo_live l
  LEFT JOIN bmkg_daily b
    ON b.weather_date = l.weather_date::date AND b.region_key = l.region_key
  WHERE l.weather_date IS NOT NULL
    AND l.temperature_2m_max_c IS NOT NULL
    AND l.precipitation_sum_mm &gt;= 0
    AND l.rain_sum_mm &gt;= 0
),
combined AS (
  SELECT DISTINCT ON (weather_date, region_key)
         weather_date, region_key, region_name,
         temp_max_c, temp_avg_c, precipitation_mm, rain_mm,
         wind_speed_max_kmh, humidity_avg_pct, source_system
  FROM (
    SELECT * FROM archive_norm
    UNION ALL SELECT * FROM live_norm
    UNION ALL SELECT * FROM bmkg_daily
  ) all_w
  WHERE region_key IN ('garut','magelang','karawang','indramayu','brebes','dki_jakarta')
  ORDER BY weather_date, region_key, prio ASC
),
rolling AS (
  SELECT *,
         ROUND(SUM(COALESCE(rain_mm, 0)) OVER (
           PARTITION BY region_key
           ORDER BY weather_date
           ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
         ), 2) AS rain_7d_mm
  FROM combined
)
SELECT weather_date,
       region_key,
       region_name,
       temp_max_c,
       temp_avg_c,
       precipitation_mm,
       rain_mm,
       rain_7d_mm,
       wind_speed_max_kmh,
       humidity_avg_pct,
       (COALESCE(rain_mm, 0) &gt;= 50
        OR COALESCE(rain_7d_mm, 0) &gt;= 150
        OR COALESCE(temp_max_c, 0) &gt;= 35
        OR COALESCE(wind_speed_max_kmh, 0) &gt;= 45) AS is_extreme_weather,
       source_system
FROM rolling</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write stg.weather_daily</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>2000</commit>
    <connection>lab-postgres</connection>
    <fields>
      <field><column_name>weather_date</column_name><stream_name>weather_date</stream_name></field>
      <field><column_name>region_key</column_name><stream_name>region_key</stream_name></field>
      <field><column_name>region_name</column_name><stream_name>region_name</stream_name></field>
      <field><column_name>temp_max_c</column_name><stream_name>temp_max_c</stream_name></field>
      <field><column_name>temp_avg_c</column_name><stream_name>temp_avg_c</stream_name></field>
      <field><column_name>precipitation_mm</column_name><stream_name>precipitation_mm</stream_name></field>
      <field><column_name>rain_mm</column_name><stream_name>rain_mm</stream_name></field>
      <field><column_name>rain_7d_mm</column_name><stream_name>rain_7d_mm</stream_name></field>
      <field><column_name>wind_speed_max_kmh</column_name><stream_name>wind_speed_max_kmh</stream_name></field>
      <field><column_name>humidity_avg_pct</column_name><stream_name>humidity_avg_pct</stream_name></field>
      <field><column_name>is_extreme_weather</column_name><stream_name>is_extreme_weather</stream_name></field>
      <field><column_name>source_system</column_name><stream_name>source_system</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>stg</schema>
    <table>weather_daily</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>464</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>