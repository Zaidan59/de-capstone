<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_food_prices</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Stage &amp; standardize raw PIHPS daily prices and DKI/InfoPangan reference prices into stg.*</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/26 10:22:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/26 10:22:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Read PIHPS Unpivoted &amp; Clean</from>
      <to>Write stg.food_prices_daily</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read DKI &amp; InfoPangan Clean</from>
      <to>Write stg.dki_reference_prices</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read PIHPS Unpivoted &amp; Clean</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH unpiv AS (
  SELECT date_param::date AS price_date,
         CASE commodity
           WHEN 'cabai_rawit' THEN 'cabai_rawit_merah'
           WHEN 'cabai_merah' THEN 'cabai_merah_keriting'
           ELSE commodity
         END AS commodity_code,
         'DKI_JAKARTA' AS province_code,
         market_tier,
         ROUND(dki_jakarta::numeric, 2) AS price_rp,
         CASE market_tier WHEN 'tradisional' THEN 'SRC-01_PIHPS_TRAD' ELSE 'SRC-02_PIHPS_MOD' END AS source_system
  FROM raw.pihps_market_prices
  UNION ALL
  SELECT date_param::date,
         CASE commodity WHEN 'cabai_rawit' THEN 'cabai_rawit_merah' WHEN 'cabai_merah' THEN 'cabai_merah_keriting' ELSE commodity END,
         'JAWA_BARAT',
         market_tier,
         ROUND(jawa_barat::numeric, 2),
         CASE market_tier WHEN 'tradisional' THEN 'SRC-01_PIHPS_TRAD' ELSE 'SRC-02_PIHPS_MOD' END
  FROM raw.pihps_market_prices
  UNION ALL
  SELECT date_param::date,
         CASE commodity WHEN 'cabai_rawit' THEN 'cabai_rawit_merah' WHEN 'cabai_merah' THEN 'cabai_merah_keriting' ELSE commodity END,
         'JAWA_TENGAH',
         market_tier,
         ROUND(jawa_tengah::numeric, 2),
         CASE market_tier WHEN 'tradisional' THEN 'SRC-01_PIHPS_TRAD' ELSE 'SRC-02_PIHPS_MOD' END
  FROM raw.pihps_market_prices
  UNION ALL
  SELECT date_param::date,
         CASE commodity WHEN 'cabai_rawit' THEN 'cabai_rawit_merah' WHEN 'cabai_merah' THEN 'cabai_merah_keriting' ELSE commodity END,
         'JAWA_BARAT',
         'produsen',
         ROUND(jawa_barat::numeric, 2),
         'SRC-03_PIHPS_PROD'
  FROM raw.pihps_produsen_prices
  UNION ALL
  SELECT date_param::date,
         CASE commodity WHEN 'cabai_rawit' THEN 'cabai_rawit_merah' WHEN 'cabai_merah' THEN 'cabai_merah_keriting' ELSE commodity END,
         'JAWA_TENGAH',
         'produsen',
         ROUND(jawa_tengah::numeric, 2),
         'SRC-03_PIHPS_PROD'
  FROM raw.pihps_produsen_prices
),
valid AS (
  SELECT *
  FROM unpiv
  WHERE price_date IS NOT NULL
    AND commodity_code IN ('beras','cabai_rawit_merah','cabai_merah_keriting','bawang_merah','bawang_putih')
    AND price_rp IS NOT NULL
    AND price_rp &gt; 0
),
lagged AS (
  SELECT *,
         LAG(price_rp) OVER (PARTITION BY commodity_code, province_code, market_tier ORDER BY price_date) AS prev_price_rp
  FROM valid
)
SELECT price_date,
       commodity_code,
       province_code,
       market_tier,
       price_rp,
       prev_price_rp,
       CASE
         WHEN prev_price_rp &gt; 0 THEN ROUND(((price_rp - prev_price_rp) / prev_price_rp) * 100.0, 4)
         ELSE NULL
       END AS daily_change_pct,
       source_system
FROM lagged
WHERE prev_price_rp IS NULL OR prev_price_rp &lt;= 0 OR ABS((price_rp - prev_price_rp) / prev_price_rp) &lt;= 3.0</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write stg.food_prices_daily</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>2000</commit>
    <connection>lab-postgres</connection>
    <fields>
      <field><column_name>price_date</column_name><stream_name>price_date</stream_name></field>
      <field><column_name>commodity_code</column_name><stream_name>commodity_code</stream_name></field>
      <field><column_name>province_code</column_name><stream_name>province_code</stream_name></field>
      <field><column_name>market_tier</column_name><stream_name>market_tier</stream_name></field>
      <field><column_name>price_rp</column_name><stream_name>price_rp</stream_name></field>
      <field><column_name>prev_price_rp</column_name><stream_name>prev_price_rp</stream_name></field>
      <field><column_name>daily_change_pct</column_name><stream_name>daily_change_pct</stream_name></field>
      <field><column_name>source_system</column_name><stream_name>source_system</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>stg</schema>
    <table>food_prices_daily</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>464</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Read DKI &amp; InfoPangan Clean</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH mapped AS (
  SELECT 'MONTHLY' AS period_type,
         replace(periode_data, '.0', '') AS period_key,
         wilayah,
         CASE komoditas
           WHEN 'BAWANG MERAH' THEN 'bawang_merah'
           WHEN 'BAWANG PUTIH' THEN 'bawang_putih'
           WHEN 'BERAS IR. I (IR 64)' THEN 'beras'
           WHEN 'BERAS MEDIUM' THEN 'beras'
           WHEN 'BERAS SETRA I/PREMIUM' THEN 'beras'
           WHEN 'CABE MERAH KERITING' THEN 'cabai_merah_keriting'
           WHEN 'CABE RAWIT MERAH' THEN 'cabai_rawit_merah'
         END AS commodity_code,
         komoditas AS raw_commodity,
         replace(trim(harga_raw), ',', '') AS clean_val,
         'SRC-04_DKI_KOMPONEN' AS source_system
  FROM raw.dki_harga_pokok_bulanan
  WHERE komoditas IN (
    'BAWANG MERAH','BAWANG PUTIH','BERAS IR. I (IR 64)','BERAS MEDIUM',
    'BERAS SETRA I/PREMIUM','CABE MERAH KERITING','CABE RAWIT MERAH'
  )
  UNION ALL
  SELECT 'YEARLY' AS period_type,
         replace(periode_data, '.0', '') AS period_key,
         'DKI JAKARTA' AS wilayah,
         CASE komoditas
           WHEN 'BAWANG MERAH' THEN 'bawang_merah'
           WHEN 'BAWANG PUTIH' THEN 'bawang_putih'
           WHEN 'BERAS IR I' THEN 'beras'
           WHEN 'BERAS IR III' THEN 'beras'
           WHEN 'CABAI MERAH KERITING' THEN 'cabai_merah_keriting'
           WHEN 'CABAI RAWIT MERAH' THEN 'cabai_rawit_merah'
           WHEN 'CABAI RAWIT MERHA' THEN 'cabai_rawit_merah'
         END AS commodity_code,
         komoditas AS raw_commodity,
         replace(trim(harga_rata_rata_raw), ',', '') AS clean_val,
         'SRC-04_INFO_PANGAN_JKT' AS source_system
  FROM raw.info_pangan_jkt
  WHERE komoditas IN (
    'BAWANG MERAH','BAWANG PUTIH','BERAS IR I','BERAS IR III',
    'CABAI MERAH KERITING','CABAI RAWIT MERAH','CABAI RAWIT MERHA'
  )
)
SELECT DISTINCT ON (period_type, period_key, wilayah, commodity_code, raw_commodity)
       period_type,
       period_key,
       wilayah,
       commodity_code,
       raw_commodity,
       ROUND(clean_val::numeric, 2) AS price_rp,
       source_system
FROM mapped
WHERE clean_val ~ '^[0-9]+(\.[0-9]+)?$'
  AND clean_val::numeric &gt; 0
ORDER BY period_type, period_key, wilayah, commodity_code, raw_commodity</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write stg.dki_reference_prices</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>lab-postgres</connection>
    <fields>
      <field><column_name>period_type</column_name><stream_name>period_type</stream_name></field>
      <field><column_name>period_key</column_name><stream_name>period_key</stream_name></field>
      <field><column_name>wilayah</column_name><stream_name>wilayah</stream_name></field>
      <field><column_name>commodity_code</column_name><stream_name>commodity_code</stream_name></field>
      <field><column_name>raw_commodity</column_name><stream_name>raw_commodity</stream_name></field>
      <field><column_name>price_rp</column_name><stream_name>price_rp</stream_name></field>
      <field><column_name>source_system</column_name><stream_name>source_system</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <schema>stg</schema>
    <table>dki_reference_prices</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>464</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>